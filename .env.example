# Copy to .env.local. Never commit .env.local.
ANTHROPIC_API_KEY=
# Optional: another Claude model. Defaults to claude-opus-5-5.
# ANTHROPIC_MODEL=
# Rehearsal without a key: known demo files use recorded readings. Shown as "Rehearsal mode" in Capture.
# LEDGERLINE_AI_FIXTURES=1

# --- Live, on Supabase (leave all of these out for the laptop demo) ---
# The database: the project's transaction pooler connection string (port 6543).
# DATABASE_URL=
# Sign-in: the project's URL and publishable key (both public), and its secret key (server only, never NEXT_PUBLIC).
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
# The address people reach Ledgerline at, for links in emails (invitations, new passwords).
# LEDGERLINE_SITE_URL=https://app.example.com
